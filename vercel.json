{
  "builds": [
    { "src": "index.php", "use": "vercel-php@0.7.1" }
  ],
  "routes": [
    {
      "src": "/(.*\\.(css|js|png|jpg|jpeg|webp|svg|ico|woff2?|ttf|map))",
      "dest": "/$1"
    },
    {
      "src": "/(assets|css|js|images|img|uploads)/(.*)",
      "dest": "/$1/$2"
    },
    {
      "src": "/(.*)",
      "dest": "/index.php"
    }
  ]
}